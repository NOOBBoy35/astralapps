# Copy this file to `.env` and fill in real values.

# ── AI features (Live Automation Builder #1, Business Audit #2, Blueprint wizard #4) ──
# Powered by Google Gemini. Server-side only — never exposed to the browser.
# Without it, the AI features run in "demo" mode (a realistic mock, no API call).
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model the AI features use. Defaults to gemini-flash-latest (fast + free tier).
GEMINI_MODEL=gemini-flash-latest

# Production server port (server/index.js). Defaults to 8080.
PORT=8080

# ── Contact form (Formspree) ──
# https://formspree.io — without it the contact form runs in demo mode.
VITE_FORMSPREE_ENDPOINT=
